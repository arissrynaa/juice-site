---
import Layout from '../layouts/Layout.astro';
import site from '../content/settings/site.json';

const menuFiles = Object.values(import.meta.glob('../content/menu/*.json', { eager: true }));
const menu = (menuFiles as any[])
  .map((m) => m.default)
  .sort((a, b) => (a.order ?? 99) - (b.order ?? 99));
const featured = menu.find((m) => m.featured) ?? menu[0];
const others = menu.filter((m) => m !== featured);

const navLinks = [
  ['Tentang Kami', '#about'],
  ['Menu & Harga', '#menu'],
  ['Cara Pesan', '#cara-pesan'],
  ['Instagram', '#instagram'],
  ['Kontak & Lokasi', '#kontak-&-lokasi'],
];
---
<Layout>
  <!-- NAVBAR (desktop) -->
  <header class="hidden md:block fixed top-0 inset-x-0 z-40 bg-surface/85 backdrop-blur border-b border-surface-border">
    <div class="max-w-7xl mx-auto px-8 flex items-center justify-between h-16">
      <a href="#hero" class="font-headline font-bold text-primary text-lg tracking-tight">{site.brand.toUpperCase()}</a>
      <nav class="flex items-center gap-6 text-sm font-semibold text-muted">
        {navLinks.map(([label, href]) => (
          <a href={href} class="hover:text-primary transition-colors">{label}</a>
        ))}
      </nav>
      <a href={site.waLink} target="_blank" rel="noopener noreferrer" class="btn-primary text-sm font-semibold">Pesan via WhatsApp</a>
    </div>
  </header>

  <main>
    <!-- #hero -->
    <section id="hero" class="w-full bg-gradient-to-b from-surface to-surface-container pt-24 md:pt-32 pb-16 lg:py-24">
      <div class="max-w-7xl mx-auto px-5 md:px-8 grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7">
          <span class="inline-block px-3 py-1 rounded-full bg-badge-green-bg text-secondary text-xs font-bold tracking-wide mb-6">{site.heroBadge}</span>
          <h1 class="text-4xl lg:text-5xl font-bold text-primary leading-tight tracking-tight mb-4">{site.slogan}</h1>
          <p class="text-base lg:text-lg text-muted max-w-xl mb-8">{site.heroSub}</p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href={site.waLink} target="_blank" rel="noopener noreferrer" class="btn-primary font-semibold text-center">Pesan Sekarang</a>
            <a href="#menu" class="inline-flex items-center justify-center px-6 py-3 rounded-lg border-[1.5px] border-primary text-primary font-semibold text-center hover:bg-primary/5 transition-colors">Lihat Menu</a>
          </div>
        </div>
        <div class="lg:col-span-5">
          <div class="bg-white rounded-xl p-4 shadow-lift border border-card-border">
            <img src={site.heroImage} alt={site.heroImageAlt} class="w-full h-72 md:h-80 object-contain rounded-lg bg-surface-container"/>
            <div class="flex items-center justify-between pt-4 px-1">
              <div>
                <p class="font-headline font-semibold text-primary">{featured.name}</p>
                <p class="text-sm text-muted">{featured.nutrition}</p>
              </div>
              {featured.badge && <span class="px-2.5 py-1 rounded-full bg-badge-cacao-bg text-primary text-xs font-bold">{featured.badge}</span>}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- #about -->
    <section id="about" class="w-full py-16 lg:py-24">
      <div class="max-w-7xl mx-auto px-5 md:px-8">
        <div class="max-w-2xl mx-auto text-center mb-12">
          <span class="block text-secondary text-xs font-bold uppercase tracking-widest mb-2">{site.aboutTitle}</span>
          <h2 class="text-3xl lg:text-4xl font-semibold text-primary mb-4">{site.aboutTitle}</h2>
          <p class="text-muted">{site.aboutBody}</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {site.advantages.map((adv) => (
            <div class="bg-white border border-card-border rounded-xl p-6">
              <span class={`inline-flex w-10 h-10 rounded-full items-center justify-center mb-4 ${adv.icon === 'nutrition' || adv.icon === 'eco' ? 'bg-badge-green-bg text-secondary' : adv.icon === 'icecream' ? 'bg-badge-cacao-bg text-primary' : 'bg-badge-citrus-bg text-badge-citrus-text'}`}>
                <span class="material-symbols-outlined">{adv.icon}</span>
              </span>
              <h3 class="font-semibold text-primary mb-2">{adv.title}</h3>
              <p class="text-sm text-muted">{adv.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- #menu -->
    <section id="menu" class="w-full py-16 lg:py-24 bg-surface-container">
      <div class="max-w-7xl mx-auto px-5 md:px-8">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="block text-secondary text-xs font-bold uppercase tracking-widest mb-2">Menu &amp; Harga</span>
          <h2 class="text-3xl lg:text-4xl font-semibold text-primary">Menu Kami</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Featured product -->
          <article class="lg:col-span-2 bg-white border border-card-border rounded-xl p-6 shadow-lift">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 items-center">
              {featured.image && (
                <div class="rounded-lg overflow-hidden bg-surface-container h-56">
                  <img src={featured.image} alt={featured.imageAlt || featured.name} class="w-full h-full object-contain p-4"/>
                </div>
              )}
              <div>
                {featured.badge && <span class="inline-block px-2.5 py-1 rounded-full bg-secondary text-white text-xs font-bold mb-3">{featured.badge}</span>}
                <h3 class="text-xl font-semibold text-primary mb-2">{featured.name}</h3>
                <p class="text-sm text-muted mb-4">{featured.description}</p>
                {featured.nutrition && <p class="text-sm text-secondary font-semibold mb-4">{featured.nutrition}</p>}
                <p class="text-2xl font-bold text-primary">{featured.price}</p>
              </div>
            </div>
          </article>
          <!-- Other items -->
          {others.map((item) => (
            <article class="bg-surface-container rounded-xl border border-surface-border p-6 flex flex-col justify-between">
              <div>
                {item.badge && <span class="inline-block px-2.5 py-1 rounded-full bg-white text-muted text-xs font-semibold mb-3">{item.badge}</span>}
                <h3 class="font-semibold text-primary mb-2">{item.name}</h3>
                <p class="text-sm text-muted">{item.description}</p>
              </div>
              <span class="mt-4 text-sm font-semibold text-muted">{item.price}</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- #cara-pesan -->
    <section id="cara-pesan" class="w-full py-16 lg:py-24">
      <div class="max-w-7xl mx-auto px-5 md:px-8">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="block text-secondary text-xs font-bold uppercase tracking-widest mb-2">Sistem PO H-1</span>
          <h2 class="text-3xl lg:text-4xl font-semibold text-primary">Cara Pesan</h2>
          <p class="text-muted mt-3">Pre-Order H-1. Pesan hari ini, nikmati kesegarannya besok!</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
          {site.steps.map((step: string, i: number) => (
            <div class="bg-white border border-card-border rounded-xl p-8 text-center">
              <span class={`inline-flex w-14 h-14 rounded-full items-center justify-center font-headline text-xl font-bold mb-4 ${i === 0 ? 'bg-badge-green-bg text-secondary' : i === 1 ? 'bg-badge-cacao-bg text-primary' : 'bg-badge-citrus-bg text-badge-citrus-text'}`}>{i + 1}</span>
              <h3 class="font-semibold text-primary mb-2">{step}</h3>
            </div>
          ))}
        </div>
        <div class="text-center">
          <a href={site.waLink} target="_blank" rel="noopener noreferrer" class="btn-secondary inline-flex items-center justify-center font-semibold px-8 py-4 text-lg">Pesan via WhatsApp</a>
        </div>
      </div>
    </section>

    <!-- #instagram -->
    <section id="instagram" class="w-full py-16 lg:py-24 bg-surface-container">
      <div class="max-w-7xl mx-auto px-5 md:px-8 text-center">
        <span class="block text-secondary text-xs font-bold uppercase tracking-widest mb-2">Instagram</span>
        <h2 class="text-3xl lg:text-4xl font-semibold text-primary mb-4">Ikuti Kami</h2>
        <p class="text-muted max-w-xl mx-auto mb-8">{site.instagramBlurb}</p>
        <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer" class="btn-primary inline-flex items-center justify-center font-semibold">Follow di Instagram</a>
      </div>
    </section>

    <!-- #kontak-&-lokasi -->
    <section id="kontak-&-lokasi" class="w-full py-16 lg:py-24">
      <div class="max-w-7xl mx-auto px-5 md:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">
          <div>
            <span class="block text-secondary text-xs font-bold uppercase tracking-widest mb-2">Kontak &amp; Lokasi</span>
            <h2 class="text-3xl lg:text-4xl font-semibold text-primary mb-6">Temukan Kami</h2>
            <ul class="space-y-4 mb-8">
              <li class="bg-white border border-card-border rounded-lg p-4">
                <p class="font-semibold text-primary">Alamat</p>
                <p class="text-sm text-muted">{site.address}</p>
              </li>
              <li class="bg-white border border-card-border rounded-lg p-4">
                <p class="font-semibold text-primary">Email</p>
                <a href={`mailto:${site.email}`} class="text-sm text-secondary hover:underline break-all">{site.email}</a>
              </li>
              <li class="bg-white border border-card-border rounded-lg p-4">
                <p class="font-semibold text-primary">WhatsApp</p>
                <a href={site.waLink} target="_blank" rel="noopener noreferrer" class="text-sm text-secondary hover:underline">{site.phoneDisplay}</a>
              </li>
              <li class="bg-white border border-card-border rounded-lg p-4">
                <p class="font-semibold text-primary">Instagram</p>
                <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer" class="text-sm text-secondary hover:underline">{site.instagramHandle}</a>
              </li>
            </ul>
          </div>
          <div class="bg-white border border-card-border rounded-xl p-4 shadow-lift">
            <iframe title={`Lokasi ${site.brand} — SMKN 1 Setu`} class="w-full h-80 rounded-lg bg-surface-container" src={site.mapsEmbed} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="w-full bg-surface-container border-t border-surface-border py-8 text-center">
    <p class="text-sm text-muted">{site.footerText}</p>
  </footer>
</Layout>
