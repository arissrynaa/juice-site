# Password untuk login admin dashboard
ADMIN_PASSWORD=ganti-password-ini

# Secret untuk signing session cookie (random string, min 32 chars)
AUTH_SECRET=ganti-dengan-random-32-karakter

# Vercel Blob token - otomatis terisi kalau Blob store sudah dibuat di dashboard Vercel.
# Untuk dev lokal boleh dikosongkan (fallback ke content/*.json).
BLOB_READ_WRITE_TOKEN=
